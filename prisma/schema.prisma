generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid()) @db.VarChar(36)
  name          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @db.VarChar(255)
  role          String         @default("student") @db.VarChar(30)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  calendarEvents CalendarEvent[]
  thesisProject ThesisProject?
  workspaceFolders WorkspaceFolder[]
}

model CalendarEvent {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @db.VarChar(36)
  title       String   @db.VarChar(200)
  date        String   @db.VarChar(10)
  endDate     String?  @db.VarChar(10)
  time        String?  @db.VarChar(8)
  endTime     String?  @db.VarChar(8)
  location    String?  @db.VarChar(200)
  type        String?  @db.VarChar(30)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model ThesisProject {
  id            String      @id @default(uuid()) @db.VarChar(36)
  userId        String      @unique @db.VarChar(36)
  finalDeadline String      @db.VarChar(10)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    Milestone[]
}

model Milestone {
  id              String        @id @default(uuid()) @db.VarChar(36)
  thesisProjectId String        @db.VarChar(36)
  name            String        @db.VarChar(200)
  targetDate      String        @db.VarChar(10)
  createdAt       DateTime      @default(now()) @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @db.DateTime(3)
  thesisProject   ThesisProject @relation(fields: [thesisProjectId], references: [id], onDelete: Cascade)

  @@index([thesisProjectId, targetDate])
}

enum WorkspaceItemKind {
  upload
  note
}

model WorkspaceFolder {
  id        String            @id @default(uuid()) @db.VarChar(36)
  userId    String            @db.VarChar(36)
  parentId  String?           @db.VarChar(36)
  name      String            @db.VarChar(100)
  rootKey   String?           @db.VarChar(32)
  createdAt DateTime          @default(now()) @db.DateTime(3)
  updatedAt DateTime          @updatedAt @db.DateTime(3)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    WorkspaceFolder?  @relation("WorkspaceFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  WorkspaceFolder[] @relation("WorkspaceFolderHierarchy")
  items     WorkspaceItem[]

  @@unique([userId, rootKey])
  @@index([userId, parentId])
}

model WorkspaceItem {
  id        String            @id @default(uuid()) @db.VarChar(36)
  folderId  String            @db.VarChar(36)
  kind      WorkspaceItemKind
  name      String            @db.VarChar(200)
  mimeType  String?           @db.VarChar(100)
  size      Int?
  fileData  Bytes?            @db.LongBlob
  text      String?           @db.LongText
  createdAt DateTime          @default(now()) @db.DateTime(3)
  updatedAt DateTime          @updatedAt @db.DateTime(3)
  folder    WorkspaceFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId, updatedAt])
  @@index([folderId, name])
}
